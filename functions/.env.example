# Variables de entorno para Firebase Functions - Sistema de Vuelos UpperDS
# Archivo: functions/.env.example
# Copiar este archivo como .env y configurar las API keys reales

# ========================================
# AERODATABOX API (PRINCIPAL - RECOMENDADO)
# ========================================
# Registrarse en: https://rapidapi.com/aerodatabox/api/aerodatabox
# Plan recomendado: PRO ($5/mes) o ULTRA ($30/mes) según volumen
# Endpoint principal: /flights/airports/iata/{code}
AERODATABOX_API_KEY=tu_rapidapi_key_aqui

# ========================================
# OPENSKY NETWORK (FALLBACK SECUNDARIO)
# ========================================
# Registrarse en: https://opensky-network.org/
# Gratuito con rate limits. Con autenticación tienes más requests.
# OAuth2 client credentials flow
OPENSKY_CLIENT_ID=tu_username_opensky
OPENSKY_CLIENT_SECRET=tu_password_opensky

# ========================================
# AVIATIONSTACK (FALLBACK TERCIARIO)
# ========================================
# Registrarse en: https://aviationstack.com/
# Plan gratuito: 1000 requests/mes
# Usar solo como último recurso debido a costos altos en planes comerciales
AVIATIONSTACK_KEY=tu_api_key_aviationstack

# ========================================
# CONFIGURACIÓN DEL SISTEMA (OPCIONAL)
# ========================================
# Orden de prioridad de APIs (separado por comas)
API_PRIORITY=aerodatabox,opensky,aviationstack

# Configuración de reintentos y timeouts
MAX_RETRIES=3
REQUEST_TIMEOUT=10000
CACHE_DURATION=300

# ========================================
# NOTAS IMPORTANTES
# ========================================
# COSTOS ESTIMADOS (10 hoteles, 40 pantallas):
# - AeroDataBox ULTRA: $30/mes (RECOMENDADO)
# - OpenSky: Gratis con límites
# - AviationStack: $1,096/mes (EVITAR en producción)
#
# ENDPOINTS PRINCIPALES:
# - AeroDataBox: /flights/airports/iata/{code} [TIER 2]
# - OpenSky: /flights/departure, /flights/arrival
# - AviationStack: /flights (con parámetros)
#
# El sistema tiene fallback automático:
# AeroDataBox → OpenSky → AviationStack → Cache local
#
# En producción, configurar estas variables en:
# Firebase Console > Functions > Configuration