  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:flight": "node test-flight.js"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "keywords": [
    "firebase",
    "functions",
    "flights",
    "airports",
    "real-time",
    "upperds",
    "opensky",
    "aviation"
  ],
  "author": "UpperDS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/upperds/upper-development.git"
  },
  "bugs": {
    "url": "https://github.com/upperds/upper-development/issues"
  },
  "homepage": "https://github.com/upperds/upper-development#readme",
  "private": true
}
